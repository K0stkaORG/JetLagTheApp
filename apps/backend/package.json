{
	"name": "backend",
	"version": "1.0.0",
	"description": "Backend server for Jetlag application",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"start": "node -e \"process.env.NODE_ENV='production'; require('./dist/index.js');\"",
		"db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
		"db:migrate": "tsx src/migrate.ts",
		"db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
		"lint": "eslint src --ext .ts",
		"format": "prettier --write \"src/**/*.ts\"",
		"type-check": "tsc --noEmit"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@jetlag/shared-types": "workspace:*",
		"bcrypt": "^6.0.0",
		"chalk": "^5.6.2",
		"cors": "^2.8.6",
		"date-fns": "^4.4.0",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^0.44.7",
		"express": "^4.22.2",
		"express-rate-limit": "^7.5.1",
		"helmet": "^7.2.0",
		"immer": "^11.1.16",
		"jose": "^6.2.8",
		"pg": "^8.22.0",
		"safe-timers": "^1.1.0",
		"socket.io": "^4.8.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.25",
		"@types/node": "^20.19.43",
		"@types/pg": "^8.20.4",
		"@types/safe-timers": "^1.1.2",
		"@types/source-map-support": "^0.5.10",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^8.57.1",
		"prettier": "^3.9.6",
		"source-map-support": "^0.5.21",
		"tsup": "^8.5.1",
		"tsx": "^4.23.8",
		"typescript": "^5.9.3"
	}
}
