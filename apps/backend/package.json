{
	"name": "backend",
	"version": "1.0.0",
	"description": "Backend server for Jetlag application",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"start": "node -e \"process.env.NODE_ENV='production'; require('./dist/index.js');\"",
		"db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
		"db:migrate": "tsx src/migrate.ts",
		"db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
		"lint": "eslint .",
		"format": "prettier --write \"src/**/*.ts\"",
		"type-check": "tsc --noEmit"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@jetlag/shared-types": "workspace:*",
		"bcrypt": "^6.0.0",
		"chalk": "^6.0.0",
		"cors": "^2.8.6",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.0",
		"drizzle-orm": "^0.45.2",
		"express": "^4.22.2",
		"express-rate-limit": "^7.5.1",
		"helmet": "^8.3.0",
		"immer": "^11.1.18",
		"jose": "^6.2.12",
		"pg": "^8.23.0",
		"piscina": "^5.3.2",
		"safe-timers": "^1.1.0",
		"socket.io": "^4.8.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.25",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"@types/safe-timers": "^1.1.2",
		"@types/source-map-support": "^0.5.10",
		"@eslint/js": "^9.39.5",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.5",
		"globals": "^16.5.0",
		"prettier": "^3.9.8",
		"source-map-support": "^0.5.21",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	}
}
